/* U-DJ — pro dark theme */

* {
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 11px;
    color: #cccccc;
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

QMainWindow, QWidget#centralwidget {
    background: #060606;
}

/* ── Deck panels ── */
#DeckWidget {
    background: #0c0c0f;
    border: 1px solid #1a1a2a;
    border-radius: 6px;
}

/* ── Mixer ── */
#MixerWidget {
    background: #0e0e12;
    border: 1px solid #1a1a2a;
    border-radius: 6px;
}

/* ── Knobs ── */
QDial {
    background: #1a1a22;
}

/* ── PFL button ── */
#PflButton {
    background: #141418;
    border: 1px solid #2a2a35;
    border-radius: 4px;
    color: #666;
    font-size: 10px;
    font-weight: bold;
}
#PflButton:checked {
    background: #002211;
    border: 1px solid #00aa55;
    color: #00dd88;
}

/* ── AUTO SYNC ── */
#SyncButton {
    background: #001a0e;
    border: 1px solid #00aa55;
    border-radius: 4px;
    color: #00dd88;
    font-size: 10px;
    font-weight: bold;
    padding: 4px;
}
#SyncButton:!checked {
    background: #140000;
    border: 1px solid #550000;
    color: #553333;
}

/* ── Library ── */
#LibSearch {
    background: #111116;
    border: 1px solid #222230;
    border-radius: 4px;
    padding: 4px 8px;
    color: #ddd;
    font-size: 12px;
}
#LibSearch:focus {
    border: 1px solid #00c8ff;
}

#BtnScan, #BtnLoadDeck {
    background: #141418;
    border: 1px solid #252530;
    border-radius: 4px;
    padding: 4px 10px;
    color: #888;
    font-size: 11px;
}
#BtnScan:hover, #BtnLoadDeck:hover {
    background: #1e1e26;
    color: #fff;
}

#LibTable {
    background: #080810;
    alternate-background-color: #0c0c14;
    gridline-color: #141420;
    border: 1px solid #141420;
    color: #cccccc;
    selection-background-color: #0a2040;
    selection-color: #ffffff;
}
#LibTable QHeaderView::section {
    background: #0e0e18;
    color: #555;
    border: none;
    border-right: 1px solid #1a1a28;
    padding: 4px 6px;
    font-size: 10px;
    font-weight: bold;
}

#ScanProgress {
    background: #1a1a22;
    border: 1px solid #2a2a35;
    border-radius: 3px;
    color: #fff;
}
#ScanProgress::chunk {
    background: #00c8ff;
    border-radius: 2px;
}

/* ── Status bar ── */
QStatusBar {
    background: #040406;
    border-top: 1px solid #141420;
    color: #333;
    font-size: 10px;
}

/* ── Scroll bars ── */
QScrollBar:vertical {
    background: #080808;
    width: 4px;
}
QScrollBar::handle:vertical {
    background: #1e1e2a;
    border-radius: 2px;
    min-height: 20px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
